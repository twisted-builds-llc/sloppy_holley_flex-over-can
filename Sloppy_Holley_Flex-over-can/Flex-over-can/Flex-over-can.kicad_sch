	(text "PAGE INDEX\n1  Top level (this page)\n2  Power - input protection + 5V regulator (VBAT_IN -> VBAT, +5V)\n3  Connector - 24-pin harness connector stubs\n4  3V3 and Sensor 5V - ME6211 LDO, TPS7B69 sensor 5V, USB VBUS OR-ing\n5  MCU ESP32-C3 - module, reset/boot, status LED, I2C pull-ups\n6  USB-C - connector, CC resistors, USB ESD\n7  CAN Bus - TJA1051T/3 transceiver, termination jumper, ESD\n8  Flex Sensor Input - pull-up, clamp, PTC-fed 12V\n9  Analog Inputs - 4x 0-5V dividers, clamps, ADS1115\n10 Low-Side Outputs - 4x BTS3256D HITFET"
		(exclude_from_sim no)
		(at 25.4 147.32 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left top)
		)
		(uuid "05843b04-c631-4679-bc77-02ad7ddc939f")
	)
